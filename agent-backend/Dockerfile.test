# ===== 容器内测试镜像（仅测试用；运行镜像见 Dockerfile）=====
# 与运行镜像分离的原因：
# - 测试需要 devDependencies（vitest 等），而运行镜像会 `npm prune --omit=dev`
# - 需要把 tests/ 带入镜像（运行镜像不 COPY tests/）
# 用法：docker compose --profile test run --rm backend-test
FROM node:22-bookworm-slim

WORKDIR /app

# better-sqlite3 需要源码编译工具链（与运行镜像同一原因：预编译包不可达）
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# 依赖层（含 devDependencies；package-lock.json 保证可复现）
COPY package.json package-lock.json ./
RUN npm ci

# 源码与测试（tsconfig 已 exclude tests/，构建产物与镜像内容均不含测试）
COPY tsconfig.json ./
COPY src ./src
COPY tests ./tests

CMD ["npm", "run", "test:all"]
