 <Worksheet ss:Name="异常与存疑复核">
  <Table>
   <Column ss:Width="110"/><Column ss:Width="560"/>
   <Row><Cell ss:StyleID="sHead"><Data ss:Type="String">项目</Data></Cell><Cell ss:StyleID="sHead"><Data ss:Type="String">内容</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">订单行</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">猪牛肉各10斤（标准化：猪牛肉各，数量 10斤）</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">工具结论</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">自动匹配 牛肉（MEA-006），置信度 90，无异常标记</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">推荐（牛肉）</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">牛肉（SKU编码 MEA-006）</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">推荐（猪肉）</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">SKU 清单中未找到“猪肉”</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">证据（牛肉）</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">SKU清单 —— MEA-006 / 牛肉 / 别名：空 / 规格：500g / 单位：斤 / 启用：是</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">证据（猪肉）</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">清单肉禽类无“猪肉”整肉条目，仅部位肉 MEA-001 五花肉、MEA-002 梅花肉、MEA-003 里脊、MEA-004 排骨、MEA-019 猪肝（停用）、MEA-020 猪肚</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">判断依据</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">“猪牛肉各”是两种肉合并写法，“各”表示各自10斤；工具只取了“牛肉”，猪肉部分被丢掉</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">已检索关键词</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">猪、猪肉、五花肉、梅花肉、里脊、排骨、猪蹄、猪肝、猪肚</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">待确认</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">猪肉具体部位（五花肉/梅花肉/里脊/排骨/猪肚）？是否确认共计20斤（各10斤）？</Data></Cell></Row>
  </Table>
 </Worksheet>

