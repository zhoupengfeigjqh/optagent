   <Row><Cell ss:StyleID="sCell"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">猪牛肉各10斤（猪肉部分）</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">10斤</Data></Cell><Cell ss:StyleID="sHl"><Data ss:Type="String">待确认：猪肉（部位待定）</Data></Cell><Cell ss:StyleID="sHl"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">待确认</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">已检索“猪肉/五花肉/梅花肉/里脊/排骨/猪蹄/猪肚”，清单无“猪肉”条目</Data></Cell></Row>
   <Row><Cell ss:StyleID="sCell"><Data ss:Type="String">合计</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">2 行</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String">直接匹配 1、模型推荐 0、待确认 1</Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="sCell"><Data ss:Type="String"></Data></Cell></Row>
