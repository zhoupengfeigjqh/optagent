{
  "servers": [
    {
      "name": "ocr",
      "transport": "http",
      "url": "http://ocr:8000/mcp",
      "file_args": {
        "ocr_image": {
          "image": "url"
        }
      },
      "confirmation": "always"
    },
    {
      "name": "hd-algorithm",
      "transport": "http",
      "url": "http://192.168.0.188:8080/mcp",
      "file_args": {
        "hd_algorithm_input_parser": {
          "item[].excelFileUrl": "url:from=item[].realRelativePath"
        }
      },
      "confirmation": "always"
    }
  ]
}