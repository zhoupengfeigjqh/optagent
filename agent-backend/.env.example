# ===== 配置样例：本地与 Docker 两种形态（完整对照）=====
#
# 分工（2026-09-20）：
#   本地（非容器）dev/start → 只读 .env.local（首次：cp .env.example .env.local）
#   Docker 容器               → compose env_file 读入库的 .env（含下方"Docker 形态"各值），
#                               另注入 .env.local 提供密钥；PUBLIC_BASE_URL 由
#                               compose environment 单点覆盖为 http://backend:3000
#
# 本文件同时是 .env.local 的创建样板：取消注释即可用，【Docker 形态】段仅供对照，勿拷入。
# config.yaml 两种形态共用同一份（compose 挂载进容器），见 config.example.yaml。

# ====================== 密钥（两种形态同值；仅容器/本机各存一份）======================

# DeepSeek API Key 兜底：config.yaml 条目未填 api_key 时以此兜底
DEEPSEEK_API_KEY=

# 签名直链 HMAC 密钥（≥16 字符）。**不配则每次启动随机生成**，
# 重启后此前发出的直链全部失效；固定配置才能保证跨重启可用。
FILE_SIGN_SECRET=

# ====================== 签名直链对外基址（两种形态取值不同！）======================
# 【本地形态】必填：本机 LAN IP（ipconfig 查实际 IPv4）。
# MUST 与 ocr-service/.env.local 的 OCR_URL_ALLOW_HOSTS、jev-service/.env.local 的
# JEV_URL_ALLOW_HOSTS 里的那个 IP 一致（白名单做**字符串精确匹配**，不做网段匹配）。
PUBLIC_BASE_URL=http://192.168.1.3:3000
# 【Docker 形态】容器内互访用服务名，由 compose environment 注入：
# PUBLIC_BASE_URL=http://backend:3000

# ====================== 运行参数（两种形态同值，故本地 .env.local 与入库 .env 都钉死）======================

# HTTP 服务端口（admin-backend 统一用 3001，避开本服务）
PORT=3000

# 运行数据根目录（用户数据、日志、usage.db）
# 【Docker】compose 挂载宿主机 agent-backend/.opt-agent → 容器 /app/.opt-agent，
#           相对 cwd（容器内 /app）解析结果相同，故两形态可同值
OPT_AGENT_ROOT=.opt-agent

# Agent 实例池容量（单机最多实例数）
POOL_SIZE=5

# 实例空闲回收超时（毫秒；30 分钟）
IDLE_TIMEOUT_MS=1800000

# MCP 单次调用超时（毫秒）
MCP_TIMEOUT_MS=30000

# 上传文件大小上限（MB，全项目统一 5MB）
UPLOAD_MAX_MB=5

# 内联预览大小上限（MB）
PREVIEW_MAX_MB=10

# read_file 单次读取截断上限（KB）
READ_TRUNCATE_KB=32

# 优雅关闭宽限期（毫秒），超时强制 abort
SHUTDOWN_GRACE_MS=15000
