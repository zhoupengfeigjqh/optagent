# ===== 环境变量样板（入库；无密钥）=====
#
# 三种形态各自读一份，互不交叉：
#   本地开发（npm run dev / npm start）  只读 .env.local
#   docker compose                      只读 .env（compose env_file 注入，且不再有 environment 覆盖）
#   裸机直跑 node dist/src/server.js     需自行 --env-file=.env
#
# 只用 .env.local 与 .env 两个文件，内容结构完全相同，差别只有"形态相关的地址"：
#   PUBLIC_BASE_URL       本地 http://<本机 LAN IP>:3000   容器 http://<宿主 LAN IP>:82
#   ADMIN_BACKEND_URL     本地 http://127.0.0.1:3001       容器 http://admin-backend:3001
#   INTENT_FOCUS_BASE_URL 本地 http://127.0.0.1:8103       容器 http://laya:8000
#
# ===== 密钥（每台部署点不同；只有这两个文件里有明文，config.yaml 只允许 $VAR 引用）=====
# 主模型密钥：config.yaml 的 models[].api_key 以 $DEEPSEEK_API_KEY 引用
DEEPSEEK_API_KEY=
# 意图聚焦（laya）密钥：config.yaml 的 intent_focus.api_key 以 $DECIS_API_KEY 引用
# 不回落 DEEPSEEK_API_KEY——落到主模型密钥只会表现为 401
DECIS_API_KEY=
# 登录凭据验签密钥（>=16 字符，MUST 与 admin-backend/.env 同值；缺省 = 鉴权未启用、回退 legacy）
AUTH_SECRET=
# 文件签名直链 HMAC 密钥（>=16 字符；固定配置才能保证跨重启已签发的 URL 仍有效）
FILE_SIGN_SECRET=

# ===== 形态项（本地/容器取值不同，逐项见文件头）=====
# 签名直链的对外基址，必填；容器内兜底成 localhost 会让 MCP 服务回源打到自己
PUBLIC_BASE_URL=
INTENT_FOCUS_BASE_URL=
ADMIN_BACKEND_URL=

# ===== 运行参数（两形态同值；与 config.ts 缺省值对齐，改这里等于改部署口径）=====
# HTTP 端口（admin-backend 固定 3001，避开本服务）
PORT=3000
# 运行数据根目录（用户数据、日志、usage.db）
OPT_AGENT_ROOT=.opt-agent
# Agent 实例池容量（单机最多实例数）
POOL_SIZE=5
# 实例空闲回收超时（毫秒）：闲置超过该时长的实例被销毁，其 MCP 连接随之关闭
# 缺省 1800000（30min），与代码一致；需要按宿主资源调整时再显式写
# IDLE_TIMEOUT_MS=1800000
# 优雅关闭宽限（毫秒），超时强制 abort；必须小于 compose 的 stop_grace_period
# 缺省 15000
# SHUTDOWN_GRACE_MS=15000

# ===== 已迁出 env（2026-11-26，改 config.yaml）=====
# MCP_TIMEOUT_MS / MCP_CONNECT_TIMEOUT_MS / LLM_MAX_RETRIES / LLM_RETRY_MAX_DELAY_MS
#   → config.yaml 的 `runtime` 块（随工具语义与模型能力变，不是机器属性）
# UPLOAD_MAX_MB / PREVIEW_MAX_MB / READ_TRUNCATE_KB
#   → 代码常量（跨服务契约与工具语义，见 src/domain/limits.ts）
# INTENT_FOCUS_SKILL_THRESHOLD / _ONTOLOGY_BEHAVIOR_THRESHOLD / _ONTOLOGY_FUNCTION_THRESHOLD /
# _REWRITE_THRESHOLD / _PLAN_THRESHOLD
#   → 已删除，阈值只认 config.yaml（同名 env 不再生效）
