# ===== 运行参数（.env）=====
# DeepSeek API Key 兜底：config.yaml 条目未填 api_key 时以此兜底
DEEPSEEK_API_KEY=

# HTTP 服务端口
PORT=3000

# 运行数据根目录（用户数据、日志、usage.db）
OPT_AGENT_ROOT=.opt-agent

# Agent 实例池容量（单机最多实例数）
POOL_SIZE=5

# 实例空闲回收超时（毫秒），默认 10 分钟
IDLE_TIMEOUT_MS=600000

# MCP 单次调用超时（毫秒）
MCP_TIMEOUT_MS=30000

# 上传文件大小上限（MB，全项目统一 5MB）
UPLOAD_MAX_MB=5

# 内联预览大小上限（MB）
PREVIEW_MAX_MB=10

# read_file 单次读取截断上限（KB）
READ_TRUNCATE_KB=32

# 优雅关闭宽限期（毫秒），超时强制 abort
SHUTDOWN_GRACE_MS=15000

# ===== 签名直链（MCP 服务回源下载）=====

# 签名直链的对外基址（**必填**，缺失则启动失败）：MCP 服务凭该地址回源下载文件
# - 容器内：compose 的 environment 已注入 http://backend:3000（此处仅供本地直跑兜底）
# - 本地直跑（npm run dev）：填 http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# 签名直链 HMAC 密钥（≥16 字符）。**不配则每次启动随机生成**，
# 重启后此前发出的直链全部失效；固定配置才能保证跨重启可用。
FILE_SIGN_SECRET=
