# ===== Docker 形态配置（随仓库入库；无密钥；本地不读本文件）=====
# 分工（2026-09-20）：
#   本文件 = Docker 容器形态取值，仅由 compose env_file 注入容器；
#   .env.local = 本地形态完整配置（含密钥、LAN IP），gitignore，本地 dev/start 只读它。
# 容器为何也注入 .env.local：运行需要密钥；其中 PUBLIC_BASE_URL（LAN IP）
# 由 compose environment 单点覆盖为 http://backend:3000。
# 双形态完整对照见 .env.example。

# HTTP 服务端口（admin-backend 统一用 3001，避开本服务）
PORT=3000

# 运行数据根目录（用户数据、日志、usage.db）
OPT_AGENT_ROOT=.opt-agent

# Agent 实例池容量（单机最多实例数）
POOL_SIZE=5

# 实例空闲回收超时（毫秒）
IDLE_TIMEOUT_MS=600000

# MCP 单次调用超时（毫秒）
MCP_TIMEOUT_MS=30000

# 上传文件大小上限（MB，全项目统一 5MB）
UPLOAD_MAX_MB=5

# 内联预览大小上限（MB）
PREVIEW_MAX_MB=10

# read_file 单次读取截断上限（KB）
READ_TRUNCATE_KB=32

# 优雅关闭宽限期（毫秒），超时强制 abort
SHUTDOWN_GRACE_MS=15000

# 签名直链对外基址（**必填**，缺失拒启动）：
# - 本地形态：在 .env.local 里填本机 LAN IP（http://192.168.1.3:3000）
# - 容器形态：compose environment 注入 http://backend:3000
#（此处不显式写死，避免一处配置两个主人）
