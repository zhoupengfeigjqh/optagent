# 依赖与构建产物
node_modules/
dist/
coverage/

# 运行期数据与密钥
# 分层（2026-09-20，见根 README 配置地图）：
#   .env        形态默认值（无密钥，随仓库入库——故此处 !.env 放行，覆盖根 .gitignore）
#   .env.local  本机私产（密钥/LAN IP，忽略）；.env.example = 其创建样板
.env
.env.*
!.env.example
!.env
config.yaml
# .opt-agent/ 2026-09-21 起入库（数字人配置/场景/skills/示例数据，供他人开箱使用）；
# SQLite WAL/SHM 伴生文件仍由根 .gitignore 忽略

# 日志与临时文件
*.log
*.tmp
*.swp

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
.history/

# 测试沙盒（tests/helpers/tmp.ts）
.test-tmp/
