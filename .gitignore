# ===== 依赖 =====
node_modules/

# ===== 构建产物与缓存 =====
dist/
dist-ssr/
*.tsbuildinfo

# Python 字节码与 pytest 缓存（ocr-service / jev-service：
# 容器内不产生，只有本地跑单测/导入模块时才有；二进制且随环境变化，无入库价值）
__pycache__/
*.pyc
.pytest_cache/

# ===== 测试覆盖率 =====
coverage/
# vitest 的 V8 provider 在**启动时**就会 `trash` 报告目录；本机安全删除垫片会拒绝该操作
# （详见 specs/001-digital-human-platform/tasks.md 的 R11 阶段 2 记录），
# 绕行方式是另指定一个目录（`--coverage.reportsDirectory=coverage-xxx`）——那类目录同样不入库
coverage-*/

# ===== 运行期数据与密钥 =====
# 注意：.env.example / config.example.yaml 属于示例模板，需纳入版本控制
# 2026-09-21 决定：.opt-agent / .platform-data **入库**——内含数字人配置、场景定义、
# skills、示例数据与 MCP 服务配置，是他人拿到可开箱可用环境的必要内容（用户确认不涉密）。
# 唯二例外：SQLite 的 WAL/SHM 伴生文件（活动数据库的临时日志，随进程再生，且二进制
# 无法 merge；写入仓库只会造成噪声，对使用者零价值）与 *.log（下方规则已覆盖）。
*.db-wal
*.db-shm
# 2026-09-20 起分层（见 README 配置地图）：
#   .env              形态配置（无密钥，随仓库入库）
#   .env.local        本机私产（密钥/局域网 IP，gitignore，不入库）
#   .env.example      模板（= .env.local 的创建样板）
.env
.env.*
!.env.example
# 需入库的形态配置逐个放行：`.env` 规则对**所有层级**生效，不显式放行的话
# 这些文件会处于"被忽略且未跟踪"状态——提交时静默丢失，而 compose 的 env_file
# 第一项默认必需，fresh clone 会直接起不来（2026-09-23 踩到）。
!admin-backend/.env
!agent-backend/.env
!ocr-service/.env
!jev-service/.env

# 服务级密钥文件（如仓库根的 .env_jev）：与 `.env.*` 同一口径，
# 避免"下划线命名"的密钥文件因不匹配点号规则而漏网入库
.env_*
config.yaml

# ===== 本地开发临时产物 =====
.dev-pids.json
typecheck-report.txt
vitest-report.txt

# ===== 日志与临时文件 =====
*.log
*.tmp
*.swp

# ===== 编辑器本地历史与系统文件 =====
.history/
.DS_Store
Thumbs.db
