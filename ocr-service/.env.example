# 模板。用法：cp ocr-service/.env.example ocr-service/.env.local，再按需填写。
# .env.local 不入库（gitignore），会覆盖入库的 .env。

# ---- 回源白名单（逗号分隔，字符串精确匹配；不在列内即拒绝）----
# 容器形态只需 backend。本机（非 Docker）跑 backend 时追加宿主机 LAN IP（ipconfig 查 IPv4），
# 该 IP MUST 与 agent-backend/.env.local 的 PUBLIC_BASE_URL 主机一致。
#OCR_URL_ALLOW_HOSTS=backend,192.168.1.3

# ---- 可调项（缺省即可用）----
# 单张图片下载上限（字节），缺省 2MB
#OCR_MAX_BYTES=2097152
# 回源下载超时（秒）
#OCR_DOWNLOAD_TIMEOUT_S=10
