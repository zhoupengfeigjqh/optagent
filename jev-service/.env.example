# Jev 决策 MCP 服务（TypeSafe System One）容器配置模板。
#
# 用法：cp .env.example .env.local 后填入真实 Key。
# .env.local 命中仓库根 .gitignore 的 `.env.*` 规则，**不入库**。
# 唯一必需项是 TYPESAFE_API_KEY；其余全部有可用缺省，按需取消注释覆盖。
#
# 注意：JEV_URL_ALLOW_HOSTS 不在此文件配置——它依赖宿主机 LAN IP，
# 由 docker-compose.yml 的 environment 注入（compose environment 优先级高于 env_file）。

# TypeSafe API Key（必需）。申请与配额见 https://docs.typesafe.ai
# 缺失时服务仍可正常启动，但三个工具都会返回可读错误。
TYPESAFE_API_KEY=

# ---- 上游端点 ----
# 整体可覆盖：便于指向官方网关（Vercel / OpenRouter / Cloudflare）或联调桩
#JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# 官方旗舰模型别名；响应里的 model 会返回具体版本号（如 jev-1.13.0）
#JEV_MODEL=jev-latest

# ---- 超时与重试 ----
# 单个请求超时（秒）
#JEV_TIMEOUT_S=20
# 瞬时失败（429 限流 / 529 过载 / 5xx / 网络错误）的最大重试次数
#JEV_MAX_RETRIES=3
# 指数退避：第 n 次重试前等 RETRY_BASE_S * 2^n 秒，且单次等待不超过 RETRY_MAX_S
# （缺省总等待有界：0.5 + 1 + 2 = 3.5 秒）
#JEV_RETRY_BASE_S=0.5
#JEV_RETRY_MAX_S=8

# ---- state 尺寸上限（防 token 成本失控）----
# 合并后 state 的字符上限（超限直接报错，不静默截断）
#JEV_MAX_STATE_CHARS=200000
# 引用文件的下载字节上限（512KB）——文件内容会整体进 state，越大越费 token
#JEV_MAX_FILE_BYTES=524288
# 引用文件回源下载超时（秒）
#JEV_DOWNLOAD_TIMEOUT_S=10
