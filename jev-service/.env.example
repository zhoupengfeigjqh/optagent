# 模板。用法：cp jev-service/.env.example jev-service/.env.local，再填入 Key。
# .env.local 不入库（gitignore），会覆盖入库的 .env。

# ---- 回源白名单（逗号分隔，字符串精确匹配；不在列内即拒绝）----
# 容器形态只需 backend。本机（非 Docker）跑 backend 时追加宿主机 LAN IP（ipconfig 查 IPv4），
# 该 IP MUST 与 agent-backend/.env.local 的 PUBLIC_BASE_URL 主机一致。
#JEV_URL_ALLOW_HOSTS=backend,192.168.1.3

# ---- TypeSafe ----
#TYPESAFE_API_KEY=                        # 唯一必需项（缺失时服务可启动，工具返回可读错误）
#JEV_BASE_URL=https://api.typesafe.ai/v1/systemone   # 上游端点，缺省官方网关
#JEV_MODEL=jev-latest                     # 模型别名；响应里的 model 会给出具体版本

# ---- 超时与重试（缺省有界：最多 3 次，总等待 ≤3.5s）----
#JEV_TIMEOUT_S=20                         # 单次请求超时（秒）
#JEV_MAX_RETRIES=3                        # 瞬时失败（429 / 529 / 5xx / 网络错误）最大重试次数
#JEV_RETRY_BASE_S=0.5                     # 退避基数：第 n 次重试前等 BASE * 2^n 秒
#JEV_RETRY_MAX_S=8                        # 单次等待上限（秒）

# ---- 尺寸上限（防 token 成本失控）----
#JEV_MAX_STATE_CHARS=200000               # 合并后 state 字符上限（超限报错，不静默截断）
#JEV_MAX_FILE_BYTES=524288                # 引用文件下载上限（字节；内容会整体进 state）
#JEV_DOWNLOAD_TIMEOUT_S=10                # 引用文件下载超时（秒）
