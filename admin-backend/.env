# ===== Docker 形态配置（随仓库入库；无密钥；本地不读本文件）=====
# 仅由 docker-compose.yml 的 env_file 注入容器；compose 文件本身不再逐行配置。
# 分工（2026-09-20，与 agent-backend 同构）：
#   本文件 = 容器形态（容器内路径/服务名口径）；
#   .env.local = 本地形态（npm run dev/start 只读它，宿主机路径口径），gitignore，样板见 .env.example。
# 两份勿混用：路径与地址的取值语境不同（/app/... ↔ ../...，服务名 ↔ 127.0.0.1）。

# HTTP 服务端口：与本地形态统一口径 3001（代码默认值即 3001，此处显式锁定）
PORT=3001

# 平台设计态根目录（bind mount 点）
PLATFORM_DATA_DIR=/app/.platform-data

# 运行环境用户数据根：与 agent-backend 共享同一份（FR-001）
OPT_AGENT_ROOT=/app/.opt-agent

# 编排声明只读投影（FR-043）
COMPOSE_FILE_PATH=/app/docker-compose.yml

# Docker Engine socket（容器状态/日志/启停）
DOCKER_SOCKET_PATH=/var/run/docker.sock

# 运行环境（agent-backend）只读端点基址：容器网络内用服务名。
# 本地形态（127.0.0.1:3000）见 .env.local——两份取值不同的典型
OPT_AGENT_BACKEND_URL=http://backend:3000

# ===== 可选项（缺省用代码默认值，按需取消注释）=====

# 运行环境只读端点 / Docker socket 共用超时（毫秒，缺省 5000）
# RUNTIME_TIMEOUT_MS=5000

# MCP 客户端超时（毫秒，缺省 10000）
# MCP_TIMEOUT_MS=10000

# SKILL ZIP 上传大小上限（MB，全项目统一 5MB；改时须与 agent-backend 同改）
# UPLOAD_MAX_MB=5

# 日志级别（缺省 info）
# LOG_LEVEL=info
