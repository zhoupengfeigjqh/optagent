# ===== 配置样例：本地与 Docker 两种形态（完整对照）=====
#
# 分工（2026-09-20）：
#   本地（非容器）dev/start → 只读 .env.local（首次：cp .env.example .env.local）
#   Docker 容器               → compose env_file 只读入库的 .env（= 本文件【Docker 形态】段）
#
# 两形态取值不同的根源：路径/地址的语境不同——容器内是挂载点 /app/... 与服务名，
# 宿主机上是源码树相对路径与 127.0.0.1。故 admin-backend 的 .env（Docker）与
# .env.local（本地）是两份完整配置，各自独立、勿混用。
#
# 本文件同时是 .env.local 的创建样板：默认启用值 = 本地形态；切换形态看注释对照。

# ====================== 本地形态（.env.local 默认启用值）======================

# HTTP 服务端口：与 Docker 形态统一 3001（代码默认值即 3001，可不写）
PORT=3001

# 平台设计态根目录（与容器形态同布局，留在 admin-backend 源码目录下）
PLATFORM_DATA_DIR=./.platform-data

# 运行环境用户数据根：与 agent-backend 共享同一份（FR-001）
OPT_AGENT_ROOT=../agent-backend/.opt-agent

# 编排声明只读投影（FR-043）
COMPOSE_FILE_PATH=../docker-compose.yml

# 运行环境（agent-backend）只读端点基址：本地 agent-backend 监听在 3000
OPT_AGENT_BACKEND_URL=http://127.0.0.1:3000

# ====================== Docker 形态（入库 .env 的值；仅供对照，勿拷入 .env.local）======================
# PORT=3001                        （同值；.env 中显式锁定）
# PLATFORM_DATA_DIR=/app/.platform-data
# OPT_AGENT_ROOT=/app/.opt-agent
# COMPOSE_FILE_PATH=/app/docker-compose.yml
# DOCKER_SOCKET_PATH=/var/run/docker.sock        （仅容器可配；本地不配则容器管理能力降级）
# OPT_AGENT_BACKEND_URL=http://backend:3000      （容器网络内用服务名）

# ====================== 可选项（两形态同默认，按需取消注释）======================
# RUNTIME_TIMEOUT_MS=5000    运行环境只读端点 / Docker socket 共用超时（毫秒）
# MCP_TIMEOUT_MS=10000       MCP 客户端超时（毫秒；管理端"发起测试"探测用）
# UPLOAD_MAX_MB=5            SKILL ZIP 上传上限（全项目统一 5MB；改时须与 agent-backend 同改）
# LOG_LEVEL=info             日志级别
