# ===== 管理端后端环境变量样板（入库；无密钥）=====
#
# 与 agent-backend 同一条规则（2026-11-26）：
#   本地 `npm run dev / start`  只读 .env.local
#   docker compose              只读 .env（compose env_file 注入，无 environment 覆盖）
# 两个文件都会被 gitignore；本模板是唯一入库的样板。
#
# 管理端**没有** config.yaml：它没有"模型/本体/判定"这类业务口径，
# 所有参数都是"秘密 + 拓扑/路径"，因此全部留在 env（见 028 contracts §1.3）。

# ---- 密钥（每台部署点不同；>=16 字符；MUST 与 agent-backend 同值）----
# 缺省 = 鉴权不可用（服务会拒绝启动，因为 schema 里是必填）
AUTH_SECRET=

# ---- 拓扑与路径（本地/容器取值不同）----
# 容器：/app/.platform-data 与 /app/.opt-agent（compose 分别挂载 admin/.platform-data 与 agent/.opt-agent）
# 本地：./.platform-data 与 ../agent-backend/.opt-agent
PLATFORM_DATA_DIR=./.platform-data
OPT_AGENT_ROOT=../agent-backend/.opt-agent
# 运行端后端地址：本地 127.0.0.1:3000；容器 http://backend:3000
OPT_AGENT_BACKEND_URL=http://127.0.0.1:3000
# 本体市场（只读）：本地 ../../optonto/.data/onto_market；容器 /opt/onto_market；不配则平台内无市场
ONTO_MARKET_DIR=

# ---- 运行参数（两形态同值；与 src/config.ts 缺省对齐）----
PORT=3001
# 调用运行端接口的超时（毫秒）
RUNTIME_TIMEOUT_MS=5000
# 探测 MCP 服务健康 / 拉取清单的超时（毫秒）
MCP_TIMEOUT_MS=10000
# 上传上限（MB，与 agent-backend / gateway 同口径，改动须四侧同步）
UPLOAD_MAX_MB=5
LOG_LEVEL=info
# 登录态有效期（秒）；缺省 7 天
AUTH_TOKEN_TTL_SECONDS=604800

# ---- 账号域存储（028 阶段 1）----
# file  = .platform-data/accounts/{users,sessions}/*.json（默认，行为与 024 一致；
#         2026-11-27 结构收敛，旧路径 users/|sessions/ 用 npm run migrate:accounts-layout 迁移）
# mysql = 账号域五表（先执行 specs/028-account-mysql-binding/schema.sql）
STORAGE_DRIVER=file
# 以下仅在 STORAGE_DRIVER=mysql 时必填
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=optagent
# MYSQL_POOL_SIZE=10

# ---- 注册链接（028 阶段 2）----
# 新链接默认有效期（秒）；0 = 长期有效。缺省 7 天
# REGISTER_LINK_DEFAULT_TTL_SECONDS=604800
# 链接对外展示基址（如 http://ops.example.com/register）；缺省 = 前台相对路径 /register?link=…
# 注意：管理后台挂在 /admin/ 下，复制相对路径会得到 /admin/register?link=…（前台无此路由），
#       本地建议显式写成 http://<host>:5173/register，生产写成网关下的完整前台地址
# REGISTER_LINK_PUBLIC_BASE_URL=
