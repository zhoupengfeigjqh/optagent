# 模板。用法：cp fresh-service/.env.example fresh-service/.env.local，再按需填写。
# .env.local 不入库（gitignore），compose 以 `required: false` 注入（缺失即用代码缺省值）。
#
# 全同步服务：调用返回时三表解析结果已经算完。四类输入全部是 http/https 直链
# （订单图片 + SKU清单 / 映射表 / 噪声词表 三个 xlsx），服务不落盘、不产文件、不回写平台，
# 也不共享用户磁盘。

# ---- 监听（缺省即可用）----
# 容器内固定 8000（宿主端口由 docker-compose.yml 发布为 8104）；MCP 端点路径 /mcp。
# 同机裸跑、与其它服务抢 8000 时才需要覆盖 MCP_PORT。
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
#MCP_PATH=/mcp
#MCP_NAME=fresh_food_mcp_v1

# ---- 匹配分流阈值（缺省即可用；合规做法是用真实标注订单校准）----
# score >= T_HIGH 进「高度匹配」；T_LOW <= score < T_HIGH 进「候选审核」；更低进「异常记录」。
# 注意 fuzz.WRatio 对中文短词给分不均匀，且对子串偏高分（番茄酱 vs 番茄 ≈ 90）。
#T_HIGH=80.0
#T_LOW=30.0
# 候选审核里返回的候选数量
#TOP_N=5

# ---- 商品数据表缓存（缺省即可用）----
# 三个 xlsx 地址组合的解析结果在进程内复用：TTL 秒，0 = 关闭缓存。
# 换数据后想立刻生效：改 TTL，或重启容器（缓存只在内存里，不落盘）。
#DATA_CACHE_TTL_SECONDS=300
# 最多缓存多少组地址组合（LRU 淘汰）
#DATA_CACHE_MAX_ENTRIES=8

# ---- 网络（缺省即可用）----
# 每次回源下载（图片 / 三份 xlsx）的超时，秒。跟随 302（对象存储签名直链常见）。
#HTTP_TIMEOUT_SECONDS=30

# ---- OCR 模型（缺省即可用）----
# PP-OCRv6 模型名；镜像构建期已把 small det/rec 权重烤进去，改这里会触发运行时下载。
#OCR_DET_MODEL=PP-OCRv6_small_det
#OCR_REC_MODEL=PP-OCRv6_small_rec

# ---- 默认商品数据文件（镜像内自带，一般不需要覆盖）----
# 三个地址留空时按下面的路径读取镜像内的 商品数据.xlsx 拆分文件。
# 换一套默认数据请重建镜像，而不是在 .env.local 里指向宿主机路径（容器里没有宿主机路径）。
#DEFAULT_SKU_PATH=/app/SKU清单.xlsx
#DEFAULT_SYNONYMS_PATH=/app/映射表.xlsx
#DEFAULT_NOISE_PATH=/app/噪声词表.xlsx
# 三个 xlsx 的工作表名（三份文件各取第一个 sheet，列名严格）
#SHEET_SKU=SKU清单
#SHEET_SYNONYMS=映射表
#SHEET_NOISE=噪声词表
